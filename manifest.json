{
  "manifest_version": 3,
  "name": "WPaint",
  "version": "1.0",
  "description": "Shows your artwork over the WPlace map and places the right color as you move the mouse over each pixel, so you don't have to click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://wplace.live/*"],
      "js": ["hover-paint.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
